# Keep the build context small and, more importantly, keep secrets and local
# state out of the image entirely.

**/.env
**/.env.*
!**/.env.example

**/node_modules
**/vendor
frontend/dist
backend/public/app

# Local database and logs — the container creates its own.
backend/database/*.sqlite
backend/storage/logs/*
backend/storage/framework/cache/*
backend/storage/framework/sessions/*
backend/storage/framework/views/*
backend/bootstrap/cache/*.php

.git
.github
.claude
security
**/.DS_Store
