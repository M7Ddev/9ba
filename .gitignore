# backend/ and frontend/ each have their own .gitignore.
# These are repo-wide safety nets so a secret can never be committed by accident.
.env
.env.*
# Templates are safe to commit — they carry placeholders, never values.
# The pattern must cover .env.production.example too, not just .env.example.
!*.example
*.key
*.pem

.idea
.vscode
.DS_Store
