# ---------------------------------------------------------------------------
# صَبّة — production environment template
#
# Copy to `.env` ON THE SERVER and fill in. Never commit the filled version.
# Every value marked CHANGE differs from the local defaults; shipping the local
# value is a security bug, not a cosmetic one.
# ---------------------------------------------------------------------------

APP_NAME="صَبّة"

# CHANGE — "local" keeps developer conveniences enabled.
APP_ENV=production

# CHANGE — the single most dangerous local default. With debug on, an unhandled
# exception renders a page listing environment variables, including your API key.
APP_DEBUG=false

# CHANGE — generate on the server with: php artisan key:generate
# Do not reuse the development key.
APP_KEY=

# CHANGE — your real API origin, https.
APP_URL=https://api.your-domain.com

# CHANGE — "debug" logs every tool call with its arguments. Use warning or error.
LOG_LEVEL=warning
LOG_CHANNEL=stack

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SQLite works, but it is a single file on disk: on ephemeral hosting the brew
# log is wiped on every redeploy. Use a managed database if history matters, and
# ensure the file lives on a persistent volume if you keep SQLite.
DB_CONNECTION=sqlite
# DB_CONNECTION=pgsql
# DB_HOST=
# DB_PORT=5432
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database

# ---------------------------------------------------------------------------
# Gemini
# ---------------------------------------------------------------------------
# CHANGE — a freshly rotated key that has never been pasted into a chat, a
# screenshot, or a commit. Set a spending cap on it in Google AI Studio:
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

GEMINI_MODEL=gemini-flash-lite-latest

# Leave true unless your host's IPv6 works and you have verified it. Symptom of
# needing it: every call dies at the timeout with "0 bytes received".
GEMINI_FORCE_IPV4=true

GEMINI_TIMEOUT=25
GEMINI_REQUEST_TIME_LIMIT=150
GEMINI_MAX_TOOL_ROUNDS=6

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# CHANGE — the exact origin of the deployed frontend, https, no trailing slash.
# config/cors.php allowlists this value; a wrong value means every browser
# request fails, and a wildcard means any site can call your API.
FRONTEND_URL=https://your-domain.com

# ---------------------------------------------------------------------------
# BEFORE YOU GO LIVE
# ---------------------------------------------------------------------------
# The API has NO AUTHENTICATION. Every endpoint is public, and rate limiting is
# per-IP only (30/min, 10/min for image scans). A script rotating IPs can spend
# your entire Gemini quota. Put something in front of it:
#   - a login (Sanctum), or
#   - a reverse proxy with access control (Cloudflare Access, basic auth), or
#   - at minimum, a hard spending cap on the key
#
# Then:
#   php artisan config:cache && php artisan route:cache
#   php artisan migrate --force
#   bash security/run-checks.sh
#
# Do not serve with `php artisan serve` — it is a single-threaded dev server.
# Use nginx/Apache + PHP-FPM, or a managed platform.
